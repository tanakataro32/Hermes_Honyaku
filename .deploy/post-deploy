#!/usr/bin/env bash
# Hermes Honyaku: run by `deploy` (tanakataro32/server-deploy) after the code is switched.
#   1. Python の文法チェック
#   2. 再起動の案内 (systemd の再起動は sudo が要るので deploy からはしない)
#      hermes-honyaku.service / lighttpd-honyaku.conf が変わっていれば入れ直しも案内する
set -euo pipefail
cd "$DEPLOY_DIR"

python3 -m py_compile hermes_honyaku.py && echo "Python の文法チェック: OK"
rm -rf __pycache__

changed() {   # 前回のコミットから変わったか (初回の --new / --adopt では常に「変わった」扱い)
    [ -z "${DEPLOY_OLD:-}" ] && return 0
    ! git diff --quiet "$DEPLOY_OLD" "$DEPLOY_NEW" -- "$1" 2>/dev/null
}
echo
echo "※ 新しいコードは再起動するまで動きません。反映するには:"
if changed hermes-honyaku.service; then
    echo "    sudo cp $DEPLOY_DIR/hermes-honyaku.service /etc/systemd/system/ && sudo systemctl daemon-reload"
fi
if changed lighttpd-honyaku.conf; then
    echo "    sudo cp $DEPLOY_DIR/lighttpd-honyaku.conf /etc/lighttpd/conf-enabled/90-honyaku.conf && sudo systemctl restart lighttpd"
fi
echo "    sudo systemctl restart hermes-honyaku"
